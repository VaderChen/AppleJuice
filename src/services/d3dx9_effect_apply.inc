                    require(constant.klass!=5 && node.type.klass<=3,unavailable);const unsigned kind=constant.set==2?0U:constant.set==1?1U:2U,stride=kind==2?4U:16U;std::vector<std::uint8_t> bytes(constant.registers*stride);
                    for(unsigned element=0;element<std::min(node.type.count(),constant.elements);++element)for(unsigned row=0;row<std::min(node.type.rows,constant.rows);++row)for(unsigned column=0;column<std::min(node.type.columns,constant.columns);++column){const unsigned input=node.offset+(element*node.type.rows*node.type.columns+row*node.type.columns+column)*4;const auto raw=word(value.bytes,input);const double number=node.type.scalar==1?double(raw!=0):node.type.scalar==2?double(static_cast<std::int32_t>(raw)):double(real(raw));const unsigned registers=constant.klass==2?constant.rows:constant.klass==3?constant.columns:1,reg=kind==2?(element*node.type.rows*node.type.columns+row*node.type.columns+column):element*registers+(constant.klass==3?column:row),component=kind==2?0:constant.klass==3?row:column;const unsigned converted=kind==0?bits(static_cast<float>(number)):kind==2?unsigned(number!=0):(!std::isfinite(number) || number<INT32_MIN || number>INT32_MAX)?0x80000000U:static_cast<unsigned>(static_cast<std::int32_t>(number));if(reg<constant.registers)put(bytes,reg*stride+component*4,converted);}
                    const unsigned per_element=kind==2?constant.rows*constant.columns:constant.klass==2?constant.rows:constant.klass==3?constant.columns:1U,first=std::min(constant.registers,range.first*per_element),last=std::min(constant.registers,range.second*per_element);

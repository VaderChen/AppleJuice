                    if(assignment.state==132)light.type=raw(assignment);
                    else {constexpr unsigned offsets[]{4,20,36,52,64,76,80,84,88,92,96,100};const unsigned count=assignment.state<=135?4:assignment.state<=137?3:1;const auto bytes=numeric_bytes(assignment,count);std::memcpy(reinterpret_cast<std::uint8_t*>(&light)+offsets[assignment.state-133],bytes.data(),bytes.size());}
                }

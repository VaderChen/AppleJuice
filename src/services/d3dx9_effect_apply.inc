                for(auto root:table.roots){const auto& constant=table.nodes[root];const auto index=fx.find(UINT32_MAX,constant.name);if(index==UINT32_MAX)continue;const auto& node=fx.nodes[index];const auto& value=*fx.values[node.index];const auto range=fx.array_ranges.contains(index)?fx.array_ranges.at(index):std::pair{0U,node.type.count()};

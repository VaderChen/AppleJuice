# 主專案只能連結已安裝 SDK；不隱含重新編譯或下載核心。
set(APPLEJUICE_KERNEL_ROOT "${CMAKE_SOURCE_DIR}/x64kernel" CACHE PATH "AppleJuiceKernel 靜態 SDK")
if(NOT EXISTS "${APPLEJUICE_KERNEL_ROOT}/lib/cmake/AppleJuiceKernel/AppleJuiceKernelConfig.cmake")
  message(FATAL_ERROR "缺少 AppleJuiceKernel SDK。請還原完整 x64kernel 靜態 SDK，或以 APPLEJUICE_KERNEL_ROOT 指定相容 SDK；操作見 docs/build-and-release.md。")
endif()
get_filename_component(APPLEJUICE_KERNEL_ROOT "${APPLEJUICE_KERNEL_ROOT}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
set(AppleJuiceKernel_DIR "${APPLEJUICE_KERNEL_ROOT}/lib/cmake/AppleJuiceKernel" CACHE PATH "AppleJuiceKernel 套件位置" FORCE)
find_package(AppleJuiceKernel 0.1 CONFIG REQUIRED
  PATHS "${APPLEJUICE_KERNEL_ROOT}/lib/cmake/AppleJuiceKernel" NO_DEFAULT_PATH)
if(NOT AppleJuiceKernel_SYSTEM STREQUAL CMAKE_SYSTEM_NAME)
  message(FATAL_ERROR "AppleJuiceKernel SDK 的宿主系統不符，請使用相同宿主系統的 SDK")
endif()
if(APPLE AND NOT AppleJuiceKernel_ARCHITECTURES STREQUAL CMAKE_OSX_ARCHITECTURES)
  message(FATAL_ERROR "AppleJuiceKernel SDK 的架構不符，請使用相同 CMAKE_OSX_ARCHITECTURES 的 SDK")
endif()
if((X64ARM_SANITIZERS AND NOT AppleJuiceKernel_SANITIZERS) OR
   (NOT X64ARM_SANITIZERS AND AppleJuiceKernel_SANITIZERS))
  message(FATAL_ERROR "AppleJuice 與 AppleJuiceKernel 的 sanitizer 設定必須相同")
endif()
option(X64ARM_LLVM_REGIONS "使用 SDK 中的 LLVM 區域編譯器" "${AppleJuiceKernel_LLVM_REGIONS}")
if(X64ARM_LLVM_REGIONS AND NOT AppleJuiceKernel_LLVM_REGIONS)
  message(FATAL_ERROR "此 SDK 不包含所要求的可選功能，請選擇相容 SDK 或關閉 X64ARM_LLVM_REGIONS")
endif()
# Windows 層的 ICU／OpenSSL 也使用相同目標架構判斷。
set(X64ARM_TARGET_ARM64 OFF)
if(CMAKE_OSX_ARCHITECTURES STREQUAL "arm64" OR (NOT CMAKE_OSX_ARCHITECTURES AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$"))
  set(X64ARM_TARGET_ARM64 ON)
endif()
set(X64ARM_NATIVE_JIT "${AppleJuiceKernel_NATIVE_JIT}")
if(X64ARM_NATIVE_JIT)
  enable_language(ASM)
  find_program(X64ARM_CODESIGN codesign REQUIRED)
endif()
add_library(x64arm_core ALIAS AppleJuiceKernel::Core)
add_library(x64arm_platform ALIAS AppleJuiceKernel::Platform)
add_library(x64arm_jit ALIAS AppleJuiceKernel::JIT)
add_library(x64arm_softfloat ALIAS AppleJuiceKernel::SoftFloat)

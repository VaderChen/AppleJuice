file(GLOB_RECURSE _hlslcc_files LIST_DIRECTORIES FALSE RELATIVE "${hlslcc_SOURCE_DIR}" "${hlslcc_SOURCE_DIR}/*")
foreach(_hlslcc_file IN LISTS _hlslcc_files)
  get_filename_component(_hlslcc_parent "${_hlslcc_destination}/${_hlslcc_file}" DIRECTORY)
  file(MAKE_DIRECTORY "${_hlslcc_parent}")
  file(COPY_FILE "${hlslcc_SOURCE_DIR}/${_hlslcc_file}" "${_hlslcc_destination}/${_hlslcc_file}" ONLY_IF_DIFFERENT)
endforeach()
set(hlslcc_SOURCE_DIR "${_hlslcc_destination}")
file(REMOVE_RECURSE "${_hlslcc_workspace}")

file(READ "${GL_SOURCE}" gl_source)
file(READ "${RASTER_SOURCE}" raster_source)
set(bytes "0")
set(offline "false")
if(METALLIB)
  file(READ "${METALLIB}" binary HEX)
  string(REGEX REPLACE "(..)" "0x\\1," bytes "${binary}")
  set(offline "true")
endif()
file(WRITE "${OUTPUT}" "#pragma once\nnamespace x64arm::fixed_metal_data {\ninline constexpr bool offline=${offline};\ninline constexpr unsigned char bytes[]={${bytes}};\ninline constexpr const char* source=R\"X64ARM_FIXED(${gl_source}\n${raster_source})X64ARM_FIXED\";\n}\n")
